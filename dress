<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DRESS CODE</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      text-align: center;
    }
    header {
      background-color: #2b2b2b;
      color: #fff;
      padding: 40px 20px;
      font-size: 48px;
      font-weight: bold;
      letter-spacing: 5px;
    }
    .image-section {
